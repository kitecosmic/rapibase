# Database
DATABASE_URL=postgres://rapibase:rapibase@localhost:5432/rapibase?sslmode=disable

# Server
PORT=8080
APP_URL=http://localhost:8080
CORS_ORIGINS=*

# Auth (Admin Dashboard)
JWT_SECRET=change-this-secret-in-production
ADMIN_EMAIL=admin@rapibase.local
ADMIN_PASSWORD=admin123

# Token Expiration
# JWT_EXPIRY: How long access tokens are valid (e.g., 15m, 1h, 24h)
# REFRESH_EXPIRY: How long refresh tokens are valid (e.g., 7d, 30d, 365d)
JWT_EXPIRY=1h
REFRESH_EXPIRY=7d

# API Keys (for third-party app authentication)
# ANON_KEY: Public key for client-side requests (requires JWT for data access)
# SERVICE_KEY: Secret key for server-side requests (full access without JWT)
# If not set, random keys will be generated on startup
ANON_KEY=your-anon-key-here
SERVICE_KEY=your-service-key-here

# SMTP (optional - for email features: verification, magic link, password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=RapiBase

# Auth Redirect URL (where to redirect users after email verification, magic link, etc.)
# Set this to your frontend app URL
AUTH_REDIRECT_URL=https://yourapp.com