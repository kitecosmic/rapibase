# =============================================================================
# RAPIBASE CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your values
# For Docker deployments, set these as environment variables in your platform
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
# For local development with docker-compose: use "db" as host
# For external PostgreSQL (Coolify, Railway, etc.): use your database URL
DATABASE_URL=postgres://rapibase:rapibase@db:5432/rapibase?sslmode=disable

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
APP_URL=http://localhost:8080
CORS_ORIGINS=*

# Static hosting for YOUR app's frontend (PocketBase-style).
# If this directory exists, rapibase serves it at / with an SPA fallback —
# same origin as the API, so fetch('/api/v1/...') needs no CORS config.
# The admin dashboard always lives at /_/ either way.
PUBLIC_DIR=./rb_public

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret for JWT signing.
# Leave BLANK to auto-generate a strong secret on first boot (persisted
# in the DB, stable across restarts). If you set it, use a long random
# value — the old example "change-this-secret-in-production" is rejected.
JWT_SECRET=

# Admin dashboard credentials.
# Leave ADMIN_PASSWORD blank to auto-generate one on first boot (printed
# once in the logs). The old example "admin123" is rejected.
ADMIN_EMAIL=admin@rapibase.local
ADMIN_PASSWORD=

# Token expiration (examples: 15m, 1h, 24h, 7d, 30d)
JWT_EXPIRY=1h
REFRESH_EXPIRY=7d

# Public self-registration (POST /api/v1/auth/signup).
# OFF by default — leave false unless your app needs open sign-ups.
# Admins always create users from the dashboard / SERVICE_KEY regardless.
AUTH_SIGNUP_ENABLED=false
# Optional comma-separated email-domain allowlist when signup is enabled
# (e.g. "keio.es,partner.com"). Empty = any domain.
AUTH_SIGNUP_ALLOWED_DOMAINS=

# Access log (records every API request: IP, identity, status).
ACCESS_LOG_ENABLED=true
ACCESS_LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# API KEYS
# -----------------------------------------------------------------------------
# ANON_KEY: Public key for client-side requests (requires JWT for data access)
# SERVICE_KEY: Secret key for server-side requests (full access without JWT)
# If not set, random keys will be generated on startup
ANON_KEY=
SERVICE_KEY=

# -----------------------------------------------------------------------------
# SMTP (Optional - for email features)
# -----------------------------------------------------------------------------
# Required for: email verification, magic link login, password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=RapiBase

# -----------------------------------------------------------------------------
# AUTH REDIRECT
# -----------------------------------------------------------------------------
# Where to redirect users after email verification, magic link, etc.
AUTH_REDIRECT_URL=

# -----------------------------------------------------------------------------
# STORAGE (MinIO - S3 Compatible)
# -----------------------------------------------------------------------------
# Enable/disable storage feature
STORAGE_ENABLED=true

# MinIO connection:
#   - Use "localhost:9000" when running Go locally (go run ./cmd/rapibase)
#   - Use "minio:9000" when running everything in Docker (docker compose up)
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# Public URL for accessing files (use your domain in production)
STORAGE_PUBLIC_URL=http://localhost:9000

# Optional: Change default ports (only affects docker-compose)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO public URLs (required in production for correct URL generation)
# MINIO_SERVER_URL: Public URL for S3 API (same as STORAGE_PUBLIC_URL with https)
# MINIO_BROWSER_REDIRECT_URL: Public URL for MinIO console
# Example for production:
#   MINIO_SERVER_URL=https://storage.yourdomain.com / same as STORAGE_PUBLIC_URL
#   MINIO_BROWSER_REDIRECT_URL=https://minio-console.yourdomain.com
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=

# -----------------------------------------------------------------------------
# FUNCTIONS (server-side TypeScript: HTTP endpoints + cron + queue workers)
# -----------------------------------------------------------------------------
# User .ts/.js files in FUNCTIONS_DIR run in an embedded sandboxed
# interpreter. Deploy via POST /api/v1/functions (SERVICE_KEY); type
# definitions at GET /api/v1/functions/types. Secrets: env vars prefixed
# FN_ are readable from functions via env.get("FN_...").
FUNCTIONS_ENABLED=true
FUNCTIONS_DIR=./rb_functions