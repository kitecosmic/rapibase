# Database
DATABASE_URL=postgres://rapibase:rapibase@localhost:5432/rapibase?sslmode=disable

# Server
PORT=8080
APP_URL=http://localhost:8080
CORS_ORIGINS=*

# Auth
JWT_SECRET=change-this-secret-in-production
ADMIN_EMAIL=admin@rapibase.local
ADMIN_PASSWORD=admin123

# API Keys (for third-party app authentication)
# ANON_KEY: Public key for client-side requests (signup, signin, public data)
# SERVICE_KEY: Secret key for server-side requests (full access, bypass RLS)
ANON_KEY=your-anon-key-here
SERVICE_KEY=your-service-key-here

# Token Expiration (optional - defaults shown)
# JWT_EXPIRY: How long access tokens are valid (e.g., 15m, 1h, 24h)
# REFRESH_EXPIRY: How long refresh tokens are valid (e.g., 7d, 30d, 365d)
JWT_EXPIRY=1h
REFRESH_EXPIRY=7d

# SMTP (optional - for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com