# =============================================================================
# RAPIBASE CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your values
# For Docker deployments, set these as environment variables in your platform
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
# For local development with docker-compose: use "db" as host
# For external PostgreSQL (Coolify, Railway, etc.): use your database URL
DATABASE_URL=postgres://rapibase:rapibase@db:5432/rapibase?sslmode=disable

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
APP_URL=http://localhost:8080
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret for JWT signing (CHANGE IN PRODUCTION!)
JWT_SECRET=change-this-secret-in-production

# Admin dashboard credentials
ADMIN_EMAIL=admin@rapibase.local
ADMIN_PASSWORD=admin123

# Token expiration (examples: 15m, 1h, 24h, 7d, 30d)
JWT_EXPIRY=1h
REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# API KEYS
# -----------------------------------------------------------------------------
# ANON_KEY: Public key for client-side requests (requires JWT for data access)
# SERVICE_KEY: Secret key for server-side requests (full access without JWT)
# If not set, random keys will be generated on startup
ANON_KEY=
SERVICE_KEY=

# -----------------------------------------------------------------------------
# SMTP (Optional - for email features)
# -----------------------------------------------------------------------------
# Required for: email verification, magic link login, password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=RapiBase

# -----------------------------------------------------------------------------
# AUTH REDIRECT
# -----------------------------------------------------------------------------
# Where to redirect users after email verification, magic link, etc.
AUTH_REDIRECT_URL=

# -----------------------------------------------------------------------------
# STORAGE (MinIO - S3 Compatible)
# -----------------------------------------------------------------------------
# Enable/disable storage feature
STORAGE_ENABLED=true

# MinIO connection:
#   - Use "localhost:9000" when running Go locally (go run ./cmd/rapibase)
#   - Use "minio:9000" when running everything in Docker (docker compose up)
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# Public URL for accessing files (use your domain in production)
STORAGE_PUBLIC_URL=http://localhost:9000

# Optional: Change default ports (only affects docker-compose)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO public URLs (required in production for correct URL generation)
# MINIO_SERVER_URL: Public URL for S3 API (same as STORAGE_PUBLIC_URL with https)
# MINIO_BROWSER_REDIRECT_URL: Public URL for MinIO console
# Example for production:
#   MINIO_SERVER_URL=https://storage.yourdomain.com / same as STORAGE_PUBLIC_URL
#   MINIO_BROWSER_REDIRECT_URL=https://minio-console.yourdomain.com
MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=